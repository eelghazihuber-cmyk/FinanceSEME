# Supabase -> Connect -> Session pooler (beginnt mit postgresql://)
DATABASE_URL=postgresql://postgres.<projekt-id>:<passwort>@<pooler-adresse>:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<projekt-id>.supabase.co

# Nur für Weg 1 (geheimer Schlüssel). Niemals ins Frontend oder nach Git!
SUPABASE_JWT_SECRET=

# Erlaubte Frontend-Adressen (später die Vercel-Adresse ergänzen)
CORS_ORIGINS=["http://localhost:5173"]
